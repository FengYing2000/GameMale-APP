# 跑 `dart run bin/vapid_keygen.dart` 產生，填進來之後就不要再改——
# 換金鑰會讓所有既有訂閱失效，每台裝置都得重新授權通知。
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 加密論壇 cookie 用。跑 `dart run pwa/server/bin/secret_keygen.dart` 產生。
# 一樣產一次就別再換——換掉所有人的登入都會解不開。
# 注意整行原封不動貼進來，結尾的 = 不能漏。
SECRET_KEY=

# 多久去論壇查一次（分鐘）
POLL_MINUTES=5

# 推播通知的總開關。設成 false 就完全不輪詢論壇、不收訂閱、不送通知，
# 網頁版也不會再顯示通知相關的介面。要開回來改這一個值就好。
PUSH_ENABLED=true
